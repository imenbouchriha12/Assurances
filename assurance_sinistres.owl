    <!-- ===== Clauses légales : obligations ===== -->

    <owl:NamedIndividual rdf:about="#Clause_DeclarationRisque">
        <rdf:type rdf:resource="#ClauseObligatoire"/>
        <libelleClause>Déclaration exacte du risque</libelleClause>
        <texteClause>L'assuré doit déclarer exactement, lors de la souscription, toutes les circonstances connues de lui permettant à l'assureur d'apprécier le risque.</texteClause>
        <referenceLegale>Code des assurances (Loi n° 92-24 du 9 mars 1992)</referenceLegale>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Clause_PaiementPrime">
        <rdf:type rdf:resource="#ClauseObligatoire"/>
        <libelleClause>Paiement de la prime</libelleClause>
        <texteClause>L'assuré est tenu de payer la prime aux échéances convenues ; à défaut, la garantie peut être suspendue.</texteClause>
        <referenceLegale>Code des assurances (Loi n° 92-24 du 9 mars 1992)</referenceLegale>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Clause_DeclarationSinistre">
        <rdf:type rdf:resource="#ClauseObligatoire"/>
        <libelleClause>Déclaration du sinistre</libelleClause>
        <texteClause>L'assuré doit déclarer tout sinistre à l'assureur dans un délai de 5 jours ouvrables à compter du jour où il en a eu connaissance.</texteClause>
        <referenceLegale>Code des assurances (Loi n° 92-24 du 9 mars 1992)</referenceLegale>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Clause_AssuranceObligatoireRC">
        <rdf:type rdf:resource="#ClauseObligatoire"/>
        <libelleClause>Assurance obligatoire de la responsabilité civile automobile</libelleClause>
        <texteClause>Tout propriétaire d'un véhicule terrestre à moteur doit être couvert par une assurance garantissant sa responsabilité civile envers les tiers.</texteClause>
        <referenceLegale>Code des assurances (Loi n° 92-24 du 9 mars 1992)</referenceLegale>
    </owl:NamedIndividual>

    <!-- ===== Clauses légales : exclusions ===== -->

    <owl:NamedIndividual rdf:about="#Clause_Exclusion_FauteIntentionnelle">
        <rdf:type rdf:resource="#ClauseExclusion"/>
        <exclut rdf:resource="#Garantie_RC_Auto"/>
        <exclut rdf:resource="#Garantie_RC_Habitation"/>
        <libelleClause>Exclusion de la faute intentionnelle</libelleClause>
        <texteClause>Les dommages causés intentionnellement par l'assuré ne sont pas garantis.</texteClause>
        <referenceLegale>Code des assurances (Loi n° 92-24 du 9 mars 1992)</referenceLegale>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Clause_Exclusion_ClesSurVehicule">
        <rdf:type rdf:resource="#ClauseExclusion"/>
        <exclut rdf:resource="#Garantie_Vol_Auto"/>
        <libelleClause>Exclusion du vol avec clés laissées dans le véhicule</libelleClause>
        <texteClause>Le vol du véhicule n'est pas garanti lorsque les clés ont été laissées sur ou dans le véhicule.</texteClause>
        <referenceLegale>Conditions générales du contrat</referenceLegale>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Clause_Exclusion_DefautEntretien">
        <rdf:type rdf:resource="#ClauseExclusion"/>
        <exclut rdf:resource="#Garantie_DegatsEaux_Hab"/>
        <libelleClause>Exclusion pour défaut d'entretien</libelleClause>
        <texteClause>Les dégâts des eaux résultant d'un défaut d'entretien manifeste des canalisations ne sont pas garantis.</texteClause>
        <referenceLegale>Conditions générales du contrat</referenceLegale>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Clause_Exclusion_Guerre">
        <rdf:type rdf:resource="#ClauseExclusion"/>
        <exclut rdf:resource="#Garantie_Incendie_Hab"/>
        <libelleClause>Exclusion des risques de guerre et d'émeutes</libelleClause>
        <texteClause>Les dommages résultant d'une guerre, d'une émeute ou d'un mouvement populaire ne sont pas garantis.</texteClause>
        <referenceLegale>Conditions générales du contrat</referenceLegale>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Clause_Exclusion_MaladieAnterieure">
        <rdf:type rdf:resource="#ClauseExclusion"/>
        <exclut rdf:resource="#Garantie_FraisMedicaux"/>
        <libelleClause>Exclusion des maladies antérieures non déclarées</libelleClause>
        <texteClause>Les frais liés à une maladie antérieure à la souscription et non déclarée ne sont pas remboursés.</texteClause>
        <referenceLegale>Conditions générales du contrat</referenceLegale>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#Clause_Exclusion_Suicide">
        <rdf:type rdf:resource="#ClauseExclusion"/>
        <exclut rdf:resource="#Garantie_Deces"/>
        <libelleClause>Exclusion du suicide la première année</libelleClause>
        <texteClause>Le décès par suicide survenu au cours de la première année du contrat n'est pas couvert.</texteClause>
        <referenceLegale>Conditions générales du contrat</referenceLegale>
    </owl:NamedIndividual>

