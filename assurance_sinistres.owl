<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE rdf:RDF [
    <!ENTITY owl "http://www.w3.org/2002/07/owl#" >
    <!ENTITY xsd "http://www.w3.org/2001/XMLSchema#" >
    <!ENTITY rdfs "http://www.w3.org/2000/01/rdf-schema#" >
    <!ENTITY rdf "http://www.w3.org/1999/02/22-rdf-syntax-ns#" >
    <!ENTITY swrl "http://www.w3.org/2003/11/swrl#" >
    <!ENTITY skos "http://www.w3.org/2004/02/skos/core#" >
]>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/assurance-sinistres#"
     xml:base="http://www.semanticweb.org/ontologies/assurance-sinistres"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/assurance-sinistres">
        <rdfs:comment xml:lang="fr">Ontologie Assurance et Gestion des Sinistres - Projet Web Semantique. Elle modélise les types de contrats d'assurance, les garanties, les clauses légales, les types de dommages et les barèmes d'indemnisation.</rdfs:comment>
        <owl:versionInfo>2.1</owl:versionInfo>
    </owl:Ontology>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- Synonymes utilisés par le module NLP pour reconnaître les concepts dans une question -->
    <owl:AnnotationProperty rdf:about="&skos;altLabel"/>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdfs:Datatype rdf:about="&xsd;date"/>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:ObjectProperty rdf:about="#aPourContrat">
        <rdfs:domain rdf:resource="#Assure"/>
        <rdfs:range rdf:resource="#Contrat"/>
        <rdfs:label xml:lang="fr">a pour contrat</rdfs:label>
        <rdfs:comment xml:lang="fr">Relie un assuré aux contrats qu'il a souscrits.</rdfs:comment>
        <skos:altLabel xml:lang="fr">a souscrit</skos:altLabel>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#appliqueFranchise">
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="#Franchise"/>
        <rdfs:label xml:lang="fr">applique la franchise</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#assurePar">
        <owl:inverseOf rdf:resource="#estAssureDe"/>
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="#Assureur"/>
        <rdfs:label xml:lang="fr">assuré par</rdfs:label>
        <rdfs:comment xml:lang="fr">Compagnie d'assurance qui porte le contrat.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#causeDommage">
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range rdf:resource="#Dommage"/>
        <rdfs:label xml:lang="fr">cause le dommage</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#concerneContrat">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range rdf:resource="#Contrat"/>
        <rdfs:label xml:lang="fr">concerne le contrat</rdfs:label>
        <rdfs:comment xml:lang="fr">Contrat au titre duquel le sinistre est déclaré.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#contientClause">
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="#Clause"/>
        <rdfs:label xml:lang="fr">contient la clause</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#declareSinistre">
        <rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="#Assure"/>
        <rdfs:range rdf:resource="#Sinistre"/>
        <rdfs:label xml:lang="fr">déclare le sinistre</rdfs:label>
        <rdfs:comment xml:lang="fr">Un sinistre est déclaré par un seul assuré (propriété inverse fonctionnelle).</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#definitBareme">
        <rdf:type rdf:resource="&owl;InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="#Assureur"/>
        <rdfs:range rdf:resource="#BaremeIndemnisation"/>
        <rdfs:label xml:lang="fr">définit le barème</rdfs:label>
        <rdfs:comment xml:lang="fr">Chaque compagnie fixe ses propres barèmes ; un barème appartient à un seul assureur (propriété inverse fonctionnelle).</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#estAssureDe">
        <rdfs:domain rdf:resource="#Assureur"/>
        <rdfs:range rdf:resource="#Contrat"/>
        <rdfs:label xml:lang="fr">est l'assureur de</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#estCouvertPar">
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">est couvert par</rdfs:label>
        <skos:altLabel xml:lang="fr">pris en charge par</skos:altLabel>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#estExpertisePar">
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range rdf:resource="#Expert"/>
        <rdfs:label xml:lang="fr">est expertisé par</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#estGarantieDe">
        <owl:inverseOf rdf:resource="#possedeGarantie"/>
        <rdfs:domain rdf:resource="#Garantie"/>
        <rdfs:range rdf:resource="#Contrat"/>
        <rdfs:label xml:lang="fr">est une garantie de</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#estIndemnisePar">
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range rdf:resource="#Indemnisation"/>
        <rdfs:label xml:lang="fr">est indemnisé par</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#exclut">
        <rdfs:domain rdf:resource="#ClauseExclusion"/>
        <rdfs:range rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">exclut</rdfs:label>
        <rdfs:comment xml:lang="fr">Garantie dont la clause d'exclusion limite la couverture.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#possedeGarantie">
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">possède la garantie</rdfs:label>
        <skos:altLabel xml:lang="fr">couvre</skos:altLabel>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#proposeGarantie">
        <rdfs:domain rdf:resource="#Assureur"/>
        <rdfs:range rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">propose la garantie</rdfs:label>
        <rdfs:comment xml:lang="fr">Catalogue de la compagnie : un contrat ne peut contenir que des garanties proposées par son assureur.</rdfs:comment>
        <skos:altLabel xml:lang="fr">offre</skos:altLabel>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#sAppliqueA">
        <rdfs:domain rdf:resource="#BaremeIndemnisation"/>
        <rdfs:range rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">s'applique à</rdfs:label>
        <rdfs:comment xml:lang="fr">Garanties pour lesquelles le barème d'indemnisation est utilisé.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#suitBareme">
        <rdfs:domain rdf:resource="#Indemnisation"/>
        <rdfs:range rdf:resource="#BaremeIndemnisation"/>
        <rdfs:label xml:lang="fr">suit le barème</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#travaillePour">
        <rdfs:domain rdf:resource="#Expert"/>
        <rdfs:range rdf:resource="#Assureur"/>
        <rdfs:label xml:lang="fr">travaille pour</rdfs:label>
        <rdfs:comment xml:lang="fr">Compagnies qui mandatent l'expert : il n'expertise que les sinistres de leurs contrats.</rdfs:comment>
        <skos:altLabel xml:lang="fr">mandaté par</skos:altLabel>
    </owl:ObjectProperty>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- Personnes et assureurs -->

    <owl:DatatypeProperty rdf:about="#adresse">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Assureur"/>
                    <rdf:Description rdf:about="#Personne"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">adresse</rdfs:label>
        <skos:altLabel xml:lang="fr">ville</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#cin">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Personne"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">numéro CIN</rdfs:label>
        <skos:altLabel xml:lang="fr">carte d'identité</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#nom">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Personne"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">nom</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#prenom">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Personne"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">prénom</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#raisonSociale">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Assureur"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">raison sociale</rdfs:label>
        <skos:altLabel xml:lang="fr">nom de la compagnie</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#specialite">
        <rdfs:domain rdf:resource="#Expert"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">spécialité</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Contrats -->

    <owl:DatatypeProperty rdf:about="#dateDebutContrat">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="&xsd;date"/>
        <rdfs:label xml:lang="fr">date de début du contrat</rdfs:label>
        <skos:altLabel xml:lang="fr">date de souscription</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#dateFinContrat">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="&xsd;date"/>
        <rdfs:label xml:lang="fr">date de fin du contrat</rdfs:label>
        <skos:altLabel xml:lang="fr">date d'expiration</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#estValide">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="&xsd;boolean"/>
        <rdfs:label xml:lang="fr">est valide</rdfs:label>
        <rdfs:comment xml:lang="fr">Valeur cohérente avec dateFinContrat à la date du 2026-10-27. Le back-end peut la recalculer avec FILTER(?dateFin &gt;= NOW()).</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#montantPrime">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="&xsd;float"/>
        <rdfs:label xml:lang="fr">montant de la prime</rdfs:label>
        <skos:altLabel xml:lang="fr">cotisation</skos:altLabel>
        <skos:altLabel xml:lang="fr">prix</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#numeroContrat">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Contrat"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">numéro de contrat</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Garanties, franchises, barèmes -->

    <owl:DatatypeProperty rdf:about="#libelleGarantie">
        <rdfs:domain rdf:resource="#Garantie"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">libellé de la garantie</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#plafondGarantie">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Garantie"/>
        <rdfs:range rdf:resource="&xsd;float"/>
        <rdfs:label xml:lang="fr">plafond de la garantie</rdfs:label>
        <skos:altLabel xml:lang="fr">montant maximum</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#montantFranchise">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Franchise"/>
        <rdfs:range rdf:resource="&xsd;float"/>
        <rdfs:label xml:lang="fr">montant de la franchise</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#libelleBareme">
        <rdfs:domain rdf:resource="#BaremeIndemnisation"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">libellé du barème</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tauxIndemnisation">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#BaremeIndemnisation"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:onDatatype rdf:resource="&xsd;float"/>
                <owl:withRestrictions rdf:parseType="Collection">
                    <rdf:Description>
                        <xsd:minInclusive rdf:datatype="&xsd;float">0.0</xsd:minInclusive>
                    </rdf:Description>
                    <rdf:Description>
                        <xsd:maxInclusive rdf:datatype="&xsd;float">1.0</xsd:maxInclusive>
                    </rdf:Description>
                </owl:withRestrictions>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="fr">taux d'indemnisation</rdfs:label>
        <rdfs:comment xml:lang="fr">Taux compris entre 0 et 1 (0.8 = 80 %).</rdfs:comment>
        <skos:altLabel xml:lang="fr">pourcentage</skos:altLabel>
    </owl:DatatypeProperty>

    <!-- Clauses légales -->

    <owl:DatatypeProperty rdf:about="#libelleClause">
        <rdfs:domain rdf:resource="#Clause"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">libellé de la clause</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#referenceLegale">
        <rdfs:domain rdf:resource="#Clause"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">référence légale</rdfs:label>
        <rdfs:comment xml:lang="fr">Texte de loi ou document contractuel sur lequel repose la clause.</rdfs:comment>
        <skos:altLabel xml:lang="fr">base légale</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#texteClause">
        <rdfs:domain rdf:resource="#Clause"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">texte de la clause</rdfs:label>
    </owl:DatatypeProperty>

    <!-- Sinistres, dommages, indemnisations -->

    <owl:DatatypeProperty rdf:about="#dateSinistre">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range rdf:resource="&xsd;date"/>
        <rdfs:label xml:lang="fr">date du sinistre</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#descriptionSinistre">
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">description du sinistre</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#lieuSinistre">
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">lieu du sinistre</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#statutSinistre">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Sinistre"/>
        <rdfs:range>
            <rdfs:Datatype>
                <owl:oneOf>
                    <rdf:Description>
                        <rdf:type rdf:resource="&rdf;List"/>
                        <rdf:first>Declare</rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="&rdf;List"/>
                                <rdf:first>EnExpertise</rdf:first>
                                <rdf:rest>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="&rdf;List"/>
                                        <rdf:first>Indemnise</rdf:first>
                                        <rdf:rest>
                                            <rdf:Description>
                                                <rdf:type rdf:resource="&rdf;List"/>
                                                <rdf:first>Refuse</rdf:first>
                                                <rdf:rest>
                                                    <rdf:Description>
                                                        <rdf:type rdf:resource="&rdf;List"/>
                                                        <rdf:first>Cloture</rdf:first>
                                                        <rdf:rest rdf:resource="&rdf;nil"/>
                                                    </rdf:Description>
                                                </rdf:rest>
                                            </rdf:Description>
                                        </rdf:rest>
                                    </rdf:Description>
                                </rdf:rest>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </owl:oneOf>
            </rdfs:Datatype>
        </rdfs:range>
        <rdfs:label xml:lang="fr">statut du sinistre</rdfs:label>
        <rdfs:comment xml:lang="fr">Valeurs possibles : Declare, EnExpertise, Indemnise, Refuse, Cloture.</rdfs:comment>
        <skos:altLabel xml:lang="fr">état du dossier</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#descriptionDommage">
        <rdfs:domain rdf:resource="#Dommage"/>
        <rdfs:range rdf:resource="&xsd;string"/>
        <rdfs:label xml:lang="fr">description du dommage</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#montantEstime">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Dommage"/>
        <rdfs:range rdf:resource="&xsd;float"/>
        <rdfs:label xml:lang="fr">montant estimé du dommage</rdfs:label>
        <skos:altLabel xml:lang="fr">coût du dommage</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#dateIndemnisation">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Indemnisation"/>
        <rdfs:range rdf:resource="&xsd;date"/>
        <rdfs:label xml:lang="fr">date d'indemnisation</rdfs:label>
        <skos:altLabel xml:lang="fr">date de paiement</skos:altLabel>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#montantIndemnisation">
        <rdf:type rdf:resource="&owl;FunctionalProperty"/>
        <rdfs:domain rdf:resource="#Indemnisation"/>
        <rdfs:range rdf:resource="&xsd;float"/>
        <rdfs:label xml:lang="fr">montant de l'indemnisation</rdfs:label>
        <skos:altLabel xml:lang="fr">montant remboursé</skos:altLabel>
    </owl:DatatypeProperty>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <owl:Class rdf:about="#Assure">
        <rdfs:subClassOf rdf:resource="#Personne"/>
        <owl:disjointWith rdf:resource="#Expert"/>
        <rdfs:label xml:lang="fr">Assuré</rdfs:label>
        <rdfs:comment xml:lang="fr">Personne qui a souscrit au moins un contrat d'assurance.</rdfs:comment>
        <skos:altLabel xml:lang="fr">client</skos:altLabel>
        <skos:altLabel xml:lang="fr">souscripteur</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#Assureur">
        <rdfs:label xml:lang="fr">Assureur</rdfs:label>
        <rdfs:comment xml:lang="fr">Compagnie d'assurance qui porte les contrats.</rdfs:comment>
        <skos:altLabel xml:lang="fr">compagnie d'assurance</skos:altLabel>
        <skos:altLabel xml:lang="fr">compagnie</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#BaremeIndemnisation">
        <!-- Un barème est défini par exactement un assureur (restriction sur la propriété inverse de definitBareme) -->
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty>
                    <rdf:Description>
                        <owl:inverseOf rdf:resource="#definitBareme"/>
                    </rdf:Description>
                </owl:onProperty>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="#Assureur"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Barème d'indemnisation</rdfs:label>
        <rdfs:comment xml:lang="fr">Grille qui fixe le taux de remboursement appliqué à une ou plusieurs garanties.</rdfs:comment>
        <skos:altLabel xml:lang="fr">barème</skos:altLabel>
        <skos:altLabel xml:lang="fr">grille d'indemnisation</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#Clause">
        <rdfs:label xml:lang="fr">Clause légale</rdfs:label>
        <rdfs:comment xml:lang="fr">Disposition légale ou contractuelle contenue dans un contrat d'assurance.</rdfs:comment>
        <skos:altLabel xml:lang="fr">clause</skos:altLabel>
        <skos:altLabel xml:lang="fr">condition</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#ClauseExclusion">
        <rdfs:subClassOf rdf:resource="#Clause"/>
        <owl:disjointWith rdf:resource="#ClauseObligatoire"/>
        <rdfs:label xml:lang="fr">Clause d'exclusion</rdfs:label>
        <rdfs:comment xml:lang="fr">Clause qui exclut certains cas de la couverture d'une garantie.</rdfs:comment>
        <skos:altLabel xml:lang="fr">exclusion</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#ClauseObligatoire">
        <rdfs:subClassOf rdf:resource="#Clause"/>
        <rdfs:label xml:lang="fr">Clause obligatoire</rdfs:label>
        <rdfs:comment xml:lang="fr">Obligation imposée à l'assuré ou à l'assureur.</rdfs:comment>
        <skos:altLabel xml:lang="fr">obligation</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#Contrat">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#possedeGarantie"/>
                <owl:someValuesFrom rdf:resource="#Garantie"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#assurePar"/>
                <owl:qualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="#Assureur"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="#numeroContrat"/>
        </owl:hasKey>
        <rdfs:label xml:lang="fr">Contrat d'assurance</rdfs:label>
        <rdfs:comment xml:lang="fr">Contrat liant un assuré à un assureur ; identifié de manière unique par son numéro.</rdfs:comment>
        <skos:altLabel xml:lang="fr">contrat</skos:altLabel>
        <skos:altLabel xml:lang="fr">police d'assurance</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#ContratAutomobile">
        <rdfs:subClassOf rdf:resource="#Contrat"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#possedeGarantie"/>
                <owl:someValuesFrom rdf:resource="#GarantieResponsabiliteCivile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Contrat automobile</rdfs:label>
        <rdfs:comment xml:lang="fr">Contrat couvrant un véhicule ; il inclut obligatoirement la responsabilité civile.</rdfs:comment>
        <skos:altLabel xml:lang="fr">assurance automobile</skos:altLabel>
        <skos:altLabel xml:lang="fr">assurance auto</skos:altLabel>
        <skos:altLabel xml:lang="fr">contrat auto</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#ContratHabitation">
        <rdfs:subClassOf rdf:resource="#Contrat"/>
        <rdfs:label xml:lang="fr">Contrat habitation</rdfs:label>
        <skos:altLabel xml:lang="fr">assurance habitation</skos:altLabel>
        <skos:altLabel xml:lang="fr">assurance logement</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#ContratSante">
        <rdfs:subClassOf rdf:resource="#Contrat"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#possedeGarantie"/>
                <owl:someValuesFrom rdf:resource="#GarantieFraisMedicaux"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Contrat santé</rdfs:label>
        <skos:altLabel xml:lang="fr">assurance santé</skos:altLabel>
        <skos:altLabel xml:lang="fr">assurance maladie</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#ContratVie">
        <rdfs:subClassOf rdf:resource="#Contrat"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#possedeGarantie"/>
                <owl:someValuesFrom rdf:resource="#GarantieDeces"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Contrat vie</rdfs:label>
        <skos:altLabel xml:lang="fr">assurance vie</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#Dommage">
        <rdfs:label xml:lang="fr">Dommage</rdfs:label>
        <skos:altLabel xml:lang="fr">dégât</skos:altLabel>
        <skos:altLabel xml:lang="fr">préjudice</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#DommageCorporel">
        <rdfs:subClassOf rdf:resource="#Dommage"/>
        <rdfs:label xml:lang="fr">Dommage corporel</rdfs:label>
        <rdfs:comment xml:lang="fr">Atteinte à l'intégrité physique d'une personne.</rdfs:comment>
        <skos:altLabel xml:lang="fr">blessure</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#DommageImmateriel">
        <rdfs:subClassOf rdf:resource="#Dommage"/>
        <rdfs:label xml:lang="fr">Dommage immatériel</rdfs:label>
        <rdfs:comment xml:lang="fr">Préjudice financier ou perte de jouissance (frais de relogement, perte d'exploitation...).</rdfs:comment>
        <skos:altLabel xml:lang="fr">préjudice financier</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#DommageMateriel">
        <rdfs:subClassOf rdf:resource="#Dommage"/>
        <rdfs:label xml:lang="fr">Dommage matériel</rdfs:label>
        <rdfs:comment xml:lang="fr">Détérioration, destruction ou perte d'un bien.</rdfs:comment>
        <skos:altLabel xml:lang="fr">dégât matériel</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#Expert">
        <rdfs:subClassOf rdf:resource="#Personne"/>
        <!-- Tout expert est mandaté par au moins une compagnie -->
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#travaillePour"/>
                <owl:someValuesFrom rdf:resource="#Assureur"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Expert</rdfs:label>
        <rdfs:comment xml:lang="fr">Expert chargé d'évaluer les dommages d'un sinistre.</rdfs:comment>
        <skos:altLabel xml:lang="fr">expert en sinistres</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#Franchise">
        <rdfs:label xml:lang="fr">Franchise</rdfs:label>
        <rdfs:comment xml:lang="fr">Somme qui reste à la charge de l'assuré lors d'une indemnisation.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Garantie">
        <rdfs:label xml:lang="fr">Garantie</rdfs:label>
        <rdfs:comment xml:lang="fr">Risque couvert par un contrat, dans la limite d'un plafond.</rdfs:comment>
        <skos:altLabel xml:lang="fr">couverture</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#GarantieDeces">
        <rdfs:subClassOf rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">Garantie décès</rdfs:label>
        <skos:altLabel xml:lang="fr">capital décès</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#GarantieDegatsDesEaux">
        <rdfs:subClassOf rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">Garantie dégâts des eaux</rdfs:label>
        <skos:altLabel xml:lang="fr">dégât des eaux</skos:altLabel>
        <skos:altLabel xml:lang="fr">fuite d'eau</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#GarantieFraisMedicaux">
        <rdfs:subClassOf rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">Garantie frais médicaux</rdfs:label>
        <skos:altLabel xml:lang="fr">frais médicaux</skos:altLabel>
        <skos:altLabel xml:lang="fr">hospitalisation</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#GarantieIncendie">
        <rdfs:subClassOf rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">Garantie incendie</rdfs:label>
        <skos:altLabel xml:lang="fr">incendie</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#GarantieResponsabiliteCivile">
        <rdfs:subClassOf rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">Garantie responsabilité civile</rdfs:label>
        <rdfs:comment xml:lang="fr">Couvre les dommages causés à des tiers.</rdfs:comment>
        <skos:altLabel xml:lang="fr">responsabilité civile</skos:altLabel>
        <skos:altLabel xml:lang="fr">RC</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#GarantieVol">
        <rdfs:subClassOf rdf:resource="#Garantie"/>
        <rdfs:label xml:lang="fr">Garantie vol</rdfs:label>
        <skos:altLabel xml:lang="fr">vol</skos:altLabel>
        <skos:altLabel xml:lang="fr">cambriolage</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#Indemnisation">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#suitBareme"/>
                <owl:cardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Indemnisation</rdfs:label>
        <rdfs:comment xml:lang="fr">Montant versé = (somme des montants estimés des dommages - franchise) x taux du barème, dans la limite du plafond de la garantie.</rdfs:comment>
        <skos:altLabel xml:lang="fr">remboursement</skos:altLabel>
        <skos:altLabel xml:lang="fr">indemnité</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#Personne">
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="#cin"/>
        </owl:hasKey>
        <rdfs:label xml:lang="fr">Personne</rdfs:label>
        <rdfs:comment xml:lang="fr">Personne physique, identifiée de manière unique par son numéro CIN.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Sinistre">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#causeDommage"/>
                <owl:minQualifiedCardinality rdf:datatype="&xsd;nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="#Dommage"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Sinistre</rdfs:label>
        <rdfs:comment xml:lang="fr">Événement déclaré par un assuré au titre d'un contrat et ayant causé au moins un dommage.</rdfs:comment>
        <skos:altLabel xml:lang="fr">accident</skos:altLabel>
        <skos:altLabel xml:lang="fr">déclaration de sinistre</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#SinistreAutomobile">
        <rdfs:subClassOf rdf:resource="#Sinistre"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#estCouvertPar"/>
                <owl:someValuesFrom rdf:resource="#GarantieResponsabiliteCivile"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="fr">Sinistre automobile</rdfs:label>
        <skos:altLabel xml:lang="fr">accident de voiture</skos:altLabel>
        <skos:altLabel xml:lang="fr">accident de la route</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#SinistreCouvert">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="#Sinistre"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="#estCouvertPar"/>
                        <owl:someValuesFrom rdf:resource="#Garantie"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="fr">Sinistre couvert</rdfs:label>
        <rdfs:comment xml:lang="fr">Classe définie : tout sinistre couvert par au moins une garantie (inféré par le raisonneur).</rdfs:comment>
        <skos:altLabel xml:lang="fr">sinistre pris en charge</skos:altLabel>
    </owl:Class>

    <owl:Class rdf:about="#SinistreGrave">
        <rdfs:subClassOf rdf:resource="#Sinistre"/>
        <rdfs:label xml:lang="fr">Sinistre grave</rdfs:label>
        <rdfs:comment xml:lang="fr">Sinistre ayant causé un dommage corporel (inféré par la règle SWRL).</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#SinistreHabitation">
        <rdfs:subClassOf rdf:resource="#Sinistre"/>
        <rdfs:label xml:lang="fr">Sinistre habitation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="#SinistreSante">
        <rdfs:subClassOf rdf:resource="#Sinistre"/>
        <rdfs:label xml:lang="fr">Sinistre santé</rdfs:label>
    </owl:Class>



