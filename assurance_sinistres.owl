    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- Les concepts principaux sont deux à deux disjoints -->
    <rdf:Description>
        <rdf:type rdf:resource="&owl;AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#Assureur"/>
            <rdf:Description rdf:about="#BaremeIndemnisation"/>
            <rdf:Description rdf:about="#Clause"/>
            <rdf:Description rdf:about="#Contrat"/>
            <rdf:Description rdf:about="#Dommage"/>
            <rdf:Description rdf:about="#Franchise"/>
            <rdf:Description rdf:about="#Garantie"/>
            <rdf:Description rdf:about="#Indemnisation"/>
            <rdf:Description rdf:about="#Personne"/>
            <rdf:Description rdf:about="#Sinistre"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="&owl;AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#ContratAutomobile"/>
            <rdf:Description rdf:about="#ContratHabitation"/>
            <rdf:Description rdf:about="#ContratSante"/>
            <rdf:Description rdf:about="#ContratVie"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="&owl;AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#DommageCorporel"/>
            <rdf:Description rdf:about="#DommageImmateriel"/>
            <rdf:Description rdf:about="#DommageMateriel"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="&owl;AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#GarantieDeces"/>
            <rdf:Description rdf:about="#GarantieDegatsDesEaux"/>
            <rdf:Description rdf:about="#GarantieFraisMedicaux"/>
            <rdf:Description rdf:about="#GarantieIncendie"/>
            <rdf:Description rdf:about="#GarantieResponsabiliteCivile"/>
            <rdf:Description rdf:about="#GarantieVol"/>
        </owl:members>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="&owl;AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#SinistreAutomobile"/>
            <rdf:Description rdf:about="#SinistreHabitation"/>
            <rdf:Description rdf:about="#SinistreSante"/>
        </owl:members>
    </rdf:Description>



    <!--
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Rules
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <rdf:Description rdf:about="#s">
        <rdf:type rdf:resource="&swrl;Variable"/>
    </rdf:Description>
    <rdf:Description rdf:about="#d">
        <rdf:type rdf:resource="&swrl;Variable"/>
    </rdf:Description>
    <rdf:Description>
        <rdfs:comment>Un sinistre qui cause un dommage corporel est considere comme grave</rdfs:comment>
        <rdf:type rdf:resource="&swrl;Imp"/>
        <swrl:body>
            <rdf:Description>
                <rdf:type rdf:resource="&swrl;AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="&swrl;ClassAtom"/>
                        <swrl:classPredicate rdf:resource="#Sinistre"/>
                        <swrl:argument1 rdf:resource="#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest>
                    <rdf:Description>
                        <rdf:type rdf:resource="&swrl;AtomList"/>
                        <rdf:first>
                            <rdf:Description>
                                <rdf:type rdf:resource="&swrl;IndividualPropertyAtom"/>
                                <swrl:propertyPredicate rdf:resource="#causeDommage"/>
                                <swrl:argument1 rdf:resource="#s"/>
                                <swrl:argument2 rdf:resource="#d"/>
                            </rdf:Description>
                        </rdf:first>
                        <rdf:rest>
                            <rdf:Description>
                                <rdf:type rdf:resource="&swrl;AtomList"/>
                                <rdf:first>
                                    <rdf:Description>
                                        <rdf:type rdf:resource="&swrl;ClassAtom"/>
                                        <swrl:classPredicate rdf:resource="#DommageCorporel"/>
                                        <swrl:argument1 rdf:resource="#d"/>
                                    </rdf:Description>
                                </rdf:first>
                                <rdf:rest rdf:resource="&rdf;nil"/>
                            </rdf:Description>
                        </rdf:rest>
                    </rdf:Description>
                </rdf:rest>
            </rdf:Description>
        </swrl:body>
        <swrl:head>
            <rdf:Description>
                <rdf:type rdf:resource="&swrl;AtomList"/>
                <rdf:first>
                    <rdf:Description>
                        <rdf:type rdf:resource="&swrl;ClassAtom"/>
                        <swrl:classPredicate rdf:resource="#SinistreGrave"/>
                        <swrl:argument1 rdf:resource="#s"/>
                    </rdf:Description>
                </rdf:first>
                <rdf:rest rdf:resource="&rdf;nil"/>
            </rdf:Description>
        </swrl:head>
    </rdf:Description>
</rdf:RDF>
